{
  "browser": {
    "enabled": true,
    "name": "quizzes"
  },
  "dist": {
    "main": "dist/main",
    "from": "assets/js/**/!(*.test).js",
    "to": "dist"
  },
  "docs": {
    "bodyHtml": "<script data-goatcounter=\"https://joshuaheagle.goatcounter.com/count\" async src=\"//gc.zgo.at/count.js\"></script>",
    "basePath": "/quizzes/docs/",
    "enabled": true,
    "from": "assets/js",
    "index": "MAIN.md",
    "title": "Quizzes",
    "to": "../joshuaheagle.local/quizzes/docs"
  },
  "images": {
    "enabled": false
  },
  "readme": {
    "from": [
      "assets/js/**/!(*.test).js"
    ]
  },
  "sass": {
    "enabled": true,
    "from": "assets/sass/**/*.+(scss|sass)",
    "path": "assets/sass",
    "to": "browser/css"
  },
  "srcPath": "assets",
  "test": {
    "options": {
      "passWithNoTests": true,
      "testPathIgnorePatterns": [
        "/node_modules"
      ]
    },
    "path": "assets/js",
    "watch": "assets/js/**/*.js"
  }
}
